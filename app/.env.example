# Superuser / migrator connection: migrations, seed, loaders. Bypasses row-level security.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_ops

# Application connection: the role the web app uses. Row-level security applies.
# The dev password is set by migration 0002; rotate it in production with ALTER ROLE.
DATABASE_URL_APP=postgres://app_user:app_user@localhost:5432/hotel_ops

# Test database (dropped and recreated by `pnpm db:test`).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_ops_test
TEST_DATABASE_URL_APP=postgres://app_user:app_user@localhost:5432/hotel_ops_test

# Secret used to derive pseudonymous stay references from PMS reservation numbers.
STAY_REF_SECRET=dev-only-change-me

# OpenAI, called through the Vercel AI SDK. Rules run first; the model is used for
# translation, leftover locations, unclear classification and linking judgments.
# Leave OPENAI_API_KEY empty to run rules-only (db:normalize without --llm).
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_REASONING=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Password given to the seven demo users that `pnpm db:seed` creates
# (admin@, gm@, engineering@, housekeeping@, supervisor@, staff@, readonly@demo.hotel).
# Pick your own; it is stored only as a hash.
DEMO_PASSWORD=change-me-demo

# Connections per process (web app and worker each). Keep web replicas × this
# plus workers × 3 under Postgres's max_connections, or put pgbouncer in front.
DB_POOL_MAX=

# Set to true when the app is served over https (the session cookie gets the Secure flag).
SESSION_COOKIE_SECURE=false

# Where uploaded client exports land (one folder per import batch). The web
# app and the worker must see the same folder: in production set it to a
# shared volume; a checkout defaults to ../data/uploads.
UPLOADS_DIR=

# Background jobs. In development the web app spawns a one-shot worker per
# job unless JOBS_SPAWN=0, in which case run `pnpm jobs:worker` yourself.
# In production only the worker service runs jobs (docs/deploy.md).
JOBS_SPAWN=
JOBS_POLL_MS=

# Where the synthetic exports live (relative to app/). Regenerate with
#   cd ../data && uv run python -m generator --seed 42 --out out/
# In production leave it empty unless the server really holds a client's
# exports: it is what "Import the demo folder" offers.
DATA_DIR=../data/out
